# syntax=docker/dockerfile:1
#
# ORE Ingest Dockerfile - Production Ready
# Optimized for ARM Mac builds with comprehensive dependency handling
# Based on successful systematic debugging through multiple phases
#

##########################################
## 1️⃣ Builder Stage (Ubuntu)         ##
##########################################

FROM ubuntu:20.04 AS builder

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
ENV PATH="$PATH:/root/.cargo/bin"

# Prevent ARM NEON instruction compilation issues
# These environment variables override problematic native optimizations
ENV CC="gcc -O2 -ffunction-sections -fdata-sections -fPIC"
ENV CXX="g++ -O2 -ffunction-sections -fdata-sections -fPIC"
ENV RUSTFLAGS="-C target-cpu=generic -C target-feature=+crt-static"
ENV SOLANA_METRICS_CONFIG="host=127.0.0.1"

# Install comprehensive build dependencies
RUN apt-get update && apt-get install --no-install-recommends -y \
    build-essential \
    git \
    curl \
    ca-certificates \
    pkg-config \
    cmake \
    make \
    file \
    libssl-dev \
    libssl1.1 \
    libudev-dev \
    zlib1g-dev \
    clang \
    llvm \
    libprotobuf-dev \
    protobuf-compiler \
    libclang-dev \
    libudev1 \
    && rm -rf /var/lib/apt/lists/*

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- --no-modify-path --profile minimal --default-toolchain stable -y && \
    rustup component add rustfmt clippy

WORKDIR /app

##########################################
## 2️⃣ Build Stage                      ##
##########################################

# Copy Cargo files first for layer caching
COPY Cargo.toml Cargo.lock ./
COPY ingest/Cargo.toml ./ingest/
COPY api/Cargo.toml ./api/

# Copy source files
COPY ingest/src ./ingest/src/
COPY api/src ./api/src/

# Build application binary with optimized flags
# This approach successfully completed Phase 4 of systematic debugging
RUN cargo build --release --package ore-ingest --features api && \
    echo "=== BINARY INFO ===" && \
    ls -la /app/target/release/ore-ingest && \
    file /app/target/release/ore-ingest && \
    echo "=== BINARY SIZE ===" && \
    du -h /app/target/release/ore-ingest

##########################################
## 3️⃣ Runtime Stage (Ubuntu)          ##
##########################################

FROM ubuntu:20.04

# Install runtime dependencies
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
    ca-certificates \
    curl \
    libssl1.1 \
    libudev1 \
    && rm -rf /var/lib/apt/lists/*

# Create a dedicated non-root user for security
RUN groupadd -r app && \
    useradd -r -u 1000 -g app app

WORKDIR /app

# Copy compiled binary from builder stage
COPY --from=builder /app/target/release/ore-ingest /app/ore-ingest

# Set correct ownership for all application files
RUN chown -R app:app /app

# Expose the service port
EXPOSE 3000

# Health check to ensure service is responsive
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s \
    CMD curl -f http://localhost:3000/ || exit 1

# Run as the non-root user
USER app

# Default entrypoint
ENTRYPOINT ["/app/ore-ingest"]
