# syntax=docker/dockerfile:1
#
# ORE Cloudflare Container Dockerfile
# Based on reev project Alpine + cargo-zigbuild patterns
# Optimized for Cloudflare container deployment with static linking
# Supports multi-architecture builds (AMD64/ARM64)
#
# This Dockerfile uses cargo-zigbuild for cross-compilation
# to create minimal, statically linked binaries suitable for Cloudflare Containers

##########################################
## 1️⃣ Builder Stage (Alpine + Zig)    ##
##########################################

FROM rust:1-alpine AS build

# Set build-time arguments
ARG TARGETPLATFORM=linux/amd64

# Install Zig, build tools, and required dependencies
RUN apk add --no-cache \
    zig \
    build-base \
    musl-dev \
    openssl-dev \
    pkgconfig \
    protobuf-dev \
    eudev-dev \
    zlib-dev \
    clang \
    llvm \
    curl \
    perl \
    && rm -rf /var/cache/apk/*

# Install cargo-zigbuild for cross-compilation
RUN cargo install cargo-zigbuild --version 0.16.8

# Add cargo bin to PATH
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /app

# Copy Cargo files first for layer caching
COPY Cargo.toml Cargo.lock ./
COPY ingest/Cargo.toml ./ingest/
COPY api/Cargo.toml ./api/

# Copy actual source code
COPY ingest/src ./ingest/src/
COPY api/src ./api/src/

# Determine target and build dependencies
RUN case ${TARGETPLATFORM} in \
    "linux/amd64") RUST_TARGET="x86_64-linux-musl" ;; \
    "linux/arm64") RUST_TARGET="aarch64-linux-musl" ;; \
    esac && \
    rustup target add ${RUST_TARGET} && \
    cargo zigbuild --release --target ${RUST_TARGET} \
    --package ore-ingest \
    --features api && \
    echo "=== BINARY INFO ===" && \
    ls -la target/${RUST_TARGET}/release/ore-ingest && \
    file target/${RUST_TARGET}/release/ore-ingest && \
    echo "=== BINARY SIZE ===" && \
    du -h target/${RUST_TARGET}/release/ore-ingest

##########################################
## 2️⃣ Runtime Stage (scratch)          ##
##########################################

FROM scratch

# Copy CA certificates for HTTPS (needed for curl/requests)
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Copy the compiled binaries from the build stage
COPY --from=build /app/target/x86_64-linux-musl/release/ore-ingest /ore-ingest-amd64
COPY --from=build /app/target/aarch64-linux-musl/release/ore-ingest /ore-ingest-arm64

# Expose the service port
EXPOSE 3000

# Default entrypoint - use amd64 by default
ENTRYPOINT ["/ore-ingest-amd64"]
