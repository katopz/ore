# syntax=docker/dockerfile:1
#
# ORE Ingest Dockerfile - Alpine with comprehensive testing results
#
# === COMPREHENSIVE TEST RESULTS ===
# 📊 FINAL STATUS: All Alpine versions FAIL despite extensive optimization attempts
#
# 🏗️ BUILT SUCCESSFULLY: All versions compile and build correctly
# 🚪 RUNTIME STATUS: Container exits immediately for ALL versions tested
#
# 📈 SIZE COMPARISON (IRRELEVANT IF DOESN'T RUN):
# - Alpine "optimized": 40.4MB (❌ DOES NOT WORK)
# - Alpine "fixed": 50.8MB (❌ DOES NOT WORK)
# - Alpine "original": 50.4MB (❌ NEVER WORKED)
# - Ubuntu optimized: 117MB (✅ WORKS PERFECTLY)
#
# 🧪 TESTING PERFORMED:
# 1️⃣ Original Alpine (commit 1bccf91):
#    - Built: ✅ SUCCESS
#    - Runtime: ❌ "rosetta error: failed to open elf at /lib64/ld-linux-x86-64.so.2"
#    - Issue: glibc binary on musl-based Alpine
#
# 2️⃣ Alpine with -C opt-level=s + strip:
#    - Built: ✅ SUCCESS
#    - Runtime: ❌ Same glibc errors
#    - Issue: Rust optimizations don't fix fundamental glibc/musl incompatibility
#
# 3️⃣ Alpine with LTO optimizations (-C lto=fat):
#    - Built: ❌ FAILED during cargo chef cook phase
#    - Error: LTO incompatible with cargo-chef dependency caching
#    - Learning: NEVER use LTO with cargo-chef multi-stage builds
#
# 4️⃣ Alpine with musl targeting:
#    - Built: ✅ SUCCESS (after 4 minutes rebuilding dependencies)
#    - Binary linking: ✅ "/lib/ld-musl-x86_64.so.1" (correct musl linking)
#    - Runtime: ❌ Container exits immediately (root cause still unknown)
#
# 🔍 ROOT CAUSE ANALYSIS:
# - glibc compatibility: ✅ FIXED with musl targeting
# - Binary linking: ✅ FIXED (musl properly linked)
# - Runtime execution: ❌ STILL FAILING (requires deeper investigation)
#
# 💡 LEARNINGS:
# - Alpine complexity goes far beyond simple musl targeting
# - Size advantages meaningless if container doesn't run
# - Ubuntu optimized version provides best reliability/size balance
# - Some Rust optimizations break cargo-chef caching architecture
#
# ✅ PRODUCTION RECOMMENDATION: Ubuntu Optimized (117MB)
# ❌ AVOID: All Alpine versions for production deployment
# 🔬 USE CASE: Alpine only for experimental size optimization research

# This ARG must be declared before the first FROM so it can be used there.
ARG BUILD_PLATFORM=linux/amd64
ARG TARGETPLATFORM=linux/amd64

##########################################
## 1️⃣ Chef Stage (cargo-chef)          ##
##########################################

FROM --platform=${BUILD_PLATFORM} lukemathwalker/cargo-chef:0.1.72-rust-1.88.0-slim-bullseye AS chef

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git \
    build-essential \
    make \
    cmake \
    libssl-dev \
    pkg-config \
    protobuf-compiler \
    libudev-dev \
    zlib1g-dev \
    musl-tools \
    libc6-amd64-cross \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Setup glibc compatibility for cross-compilation
RUN ln -s /usr/x86_64-linux-gnu/lib64/ /lib64
ENV LD_LIBRARY_PATH="/lib64:/usr/x86_64-linux-gnu/lib"

# Add both musl and glibc targets for maximum compatibility
# Note: x86_64-unknown-linux-musl requires musl-tools for static linking
RUN rustup target add x86_64-unknown-linux-musl x86_64-unknown-linux-gnu && \
    rustup component add rust-src

WORKDIR /app

##########################################
## 2️⃣ Planner Stage                   ##
##########################################

FROM chef AS planner

# Re-declare the ARG for this stage
ARG BUILD_PLATFORM

# Copy workspace files for dependency planning
COPY Cargo.toml Cargo.lock ./
COPY ingest/Cargo.toml ./ingest/
COPY api/Cargo.toml ./api/

# Copy source files
COPY ingest/src ./ingest/src/
COPY api/src ./api/src/

# Prepare to recipe for building dependencies
RUN cargo chef prepare --recipe-path recipe.json

##########################################
## 3️⃣ Builder Stage                    ##
##########################################

FROM chef AS builder

# Re-declare the ARG for this stage
ARG BUILD_PLATFORM

# Copy to recipe from planner stage
COPY --from=planner /app/recipe.json recipe.json

# Build to dependencies using to recipe with musl targeting
# Use conservative flags for dependency building
RUN PKG_CONFIG_ALLOW_CROSS=1 \
    PROTOC=/usr/bin/protoc \
    RUSTFLAGS="-C target-cpu=generic -C opt-level=0" \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER=musl-gcc \
    cargo chef cook --release --target x86_64-unknown-linux-musl --recipe-path recipe.json

# Copy to actual source code
COPY Cargo.toml Cargo.lock ./
COPY ingest/Cargo.toml ./ingest/
COPY api/Cargo.toml ./api/
COPY ingest/src ./ingest/src/
COPY api/src ./api/src/

# Build to actual application binary with musl target for native Alpine compatibility
# Build debug version to investigate segfault
RUN PKG_CONFIG_ALLOW_CROSS=1 \
    PROTOC=/usr/bin/protoc \
    RUSTFLAGS="-C target-cpu=generic -C opt-level=0 -C debuginfo=1" \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER=musl-gcc \
    cargo build --target x86_64-unknown-linux-musl --package ore-ingest --features api

# Debug: Check the binary properties (debug build)
RUN ls -la /app/target/x86_64-unknown-linux-musl/debug/ore-ingest

##########################################
## 4️⃣ Runtime Stage (Alpine, native musl)  ##
##########################################

FROM --platform=${BUILD_PLATFORM} alpine:3.19

# Install additional debugging tools and minimal runtime dependencies for native musl
RUN apk update && \
    apk add --no-cache \
    ca-certificates \
    curl \
    libgcc \
    gdb \
    strace \
    && rm -rf /var/cache/apk/*

# Clean library path for native musl execution
ENV LD_LIBRARY_PATH="/lib:/usr/lib"

# Add debug environment variables
ENV RUST_BACKTRACE=1
ENV RUST_LOG=debug

# Create a dedicated non-root user for security
RUN addgroup -g 1000 app && \
    adduser -D -u 1000 -G app app

# Set working directory
WORKDIR /app

# Copy to compiled binary from the builder stage (musl debug target)
COPY --from=builder /app/target/x86_64-unknown-linux-musl/debug/ore-ingest /app/ore-ingest

# Set correct ownership for all application files
RUN chown -R app:app /app

# Create data directory for database
RUN mkdir -p /app/data && chown app:app /app/data

# Expose service port
EXPOSE 4000

# Health check to ensure API service is responsive
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s \
    CMD curl -f http://localhost:4000/ || exit 1

# Run as a non-root user
USER app

# Default entrypoint with environment variables
ENV PORT=4000
ENV TURSO_URL=/app/data/ore.db
ENTRYPOINT ["/app/ore-ingest"]
